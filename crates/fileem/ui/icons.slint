    // the view mode's icon (ViewMode::index)
    public pure function view(mode: int) -> string {
        return mode == 0 ? view-xl : mode == 1 ? view-large : mode == 2 ? view-medium : mode == 3 ? view-small
            : mode == 4 ? view-list : mode == 5 ? view-details : mode == 6 ? view-tiles : view-content;
    }
}

// Category icons, numbered like `icon_of` in src/app.rs.
// One item of a right-click menu (src/menu.rs); `id` is handed back to `menu-activated`.
export struct MenuRow {
    id: int,
    title: string,
    enabled: bool,
    checkable: bool,
    checked: bool,
}

export component FileIcon {
    in property <int> kind;
    in property <bool> dimmed;
    width: 18px;
    height: 18px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        opacity: root.dimmed ? 0.55 : 1.0;
        commands: kind == 0 ? Icons.folder : kind == 1 ? Icons.file-outline : kind == 13 ? Icons.link
            : kind == 20 ? Icons.home : kind == 21 ? Icons.drive : Icons.file;
        fill: kind == 0 ? #d9a02b : kind == 2 ? #3fa66a : kind == 3 ? #b356c4 : kind == 4 ? #d4524a
            : kind == 5 ? #a07a46 : kind == 6 ? #d93a35 : kind == 7 ? #2f6fd1 : kind == 8 ? #1f8f4e
            : kind == 9 ? #d0632d : kind == 10 ? #3a8fd9 : kind == 12 ? #6a6fd8
            : kind == 20 ? Palette.accent-background : Palette.foreground.with-alpha(0.65);
    }
}

// A flat icon button with a tooltip-style accessible label.
export component ToolButton {
    in property <string> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <bool> checked;
    callback clicked();
    width: 30px;
    height: 30px;
    accessible-role: button;
    accessible-label: tooltip;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { clicked(); } }
    Rectangle {
        border-radius: 4px;
        background: touch.pressed && enabled ? Palette.foreground.with-alpha(0.16)
            : checked ? Palette.accent-background.with-alpha(0.22)
            : touch.has-hover && enabled ? Palette.foreground.with-alpha(0.08) : transparent;
    }
    Path {
        width: 18px;
        height: 18px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: icon;
        fill: Palette.foreground;
        opacity: enabled ? 1.0 : 0.35;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A button of the F-key bar: the key in bold accent, then what it does (the Java `fkey`).
export component FunctionKey {
    in property <string> key;
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    horizontal-stretch: 1;
    min-width: 40px;
    height: 24px;
    accessible-role: button;
    accessible-label: key + " " + label;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { clicked(); } }
    Rectangle {
        border-radius: 4px;
        background: touch.pressed && enabled ? Palette.foreground.with-alpha(0.16)
            : touch.has-hover && enabled ? Palette.foreground.with-alpha(0.08) : transparent;
    }
    HorizontalLayout {
        alignment: center;
        spacing: 5px;
        padding-left: 4px;
        padding-right: 4px;
        opacity: enabled ? 1.0 : 0.4;
        Text {
            text: root.key;
            font-weight: 700;
            color: Palette.accent-background;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
