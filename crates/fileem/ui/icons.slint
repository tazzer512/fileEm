// Category icons, numbered like `icon_of` in src/app.rs.
export component FileIcon {
    in property <int> kind;
    in property <bool> dimmed;
    width: 18px;
    height: 18px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        opacity: root.dimmed ? 0.55 : 1.0;
        commands: kind == 0 ? Icons.folder : kind == 1 ? Icons.file-outline : kind == 13 ? Icons.link
            : kind == 20 ? Icons.home : kind == 21 ? Icons.drive : Icons.file;
        fill: kind == 0 ? #d9a02b : kind == 2 ? #3fa66a : kind == 3 ? #b356c4 : kind == 4 ? #d4524a
            : kind == 5 ? #a07a46 : kind == 6 ? #d93a35 : kind == 7 ? #2f6fd1 : kind == 8 ? #1f8f4e
            : kind == 9 ? #d0632d : kind == 10 ? #3a8fd9 : kind == 12 ? #6a6fd8
            : kind == 20 ? Palette.accent-background : Palette.foreground.with-alpha(0.65);
    }
}
