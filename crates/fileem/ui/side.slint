// One explorer side: folder tree | tab bar, address bar (breadcrumbs or typed path), view and
// sort buttons + filter, the files (details list with resizable columns, or the grid of the
// other views), status line with the item size. Everything comes in through `view` (built by
// src/app.rs); requests that would be function calls elsewhere (scroll to a row, edit the
// address, focus the filter) arrive as sequence numbers that change.

import { LineEdit, ListView, Palette, ScrollView, Slider } from "std-widgets.slint";
import { Icons, FileIcon, ToolButton } from "icons.slint";
import { GridItem } from "grid.slint";

export struct FileRow {
    name: string,
    size: string,
    kind: string,
    modified: string,
    created: string,
    accessed: string,
    extension: string,
    attributes: string,
    // Category as an int: see FileIcon and src/app.rs `icon_of`.
    icon: int,
    selected: bool,
    current: bool,
    hidden: bool,
    // an image thumbnail in the grid views (empty: the type icon)
    thumb: image,
}

export struct TreeRow {
    name: string,
    depth: int,
    // Section titles ("Quick access", "This computer") are not folders.
    header: bool,
    expandable: bool,
    expanded: bool,
    // Showing the tab's folder (boxed), or one of its parents (bold).
    current: bool,
    on-path: bool,
    icon: int,
    // a folder that can be dragged (not a section title or a drive)
    draggable: bool,
    // a drive's free space ("12 GB free of 64 GB", "Ejecting…"), empty for none
    extra: string,
    // a drive that can be ejected (an eject button), and one being ejected now
    ejectable: bool,
    ejecting: bool,
}

export struct TabRow {
    title: string,
    active: bool,
}

export struct CrumbRow {
    label: string,
    // the file system root: a drive icon
    drive: bool,
}

// A visible column after Name; `col` is the src/columns.rs ColumnId index.
export struct ColumnRow {
    col: int,
    title: string,
    width: length,
    align-right: bool,
}

export struct SideView {
    files: [FileRow],
    // the Details list's rows: `files`, or none in the grid views (always the same two models,
    // so the list never rebuilds its rows when the view is pushed again)
    list-files: [FileRow],
    // the grid's slots, numbered (src/grid.rs `slot_count`)
    slots: [int],
    // List's column fits the widest of these names, a line each (src/grid.rs `names_to_measure`)
    measure-names: string,
    tree: [TreeRow],
    tabs: [TabRow],
    crumbs: [CrumbRow],
    address: string,
    status: string,
    message: string,
    filter: string,
    // ColumnId index of the sort column
    sort-column: int,
    sort-ascending: bool,
    // the side commands and keys act on
    active: bool,
    tree-width: length,
    // scroll `ensure-row` into view whenever `ensure-seq` changes; likewise for the others
    ensure-row: int,
    ensure-seq: int,
    top-seq: int,
    edit-seq: int,
    filter-seq: int,
    tree-row: int,
    tree-seq: int,
    // the tree row whose menu is open (-1: none)
    tree-menu-row: int,
    // ViewMode::index (5: Details) and the grid's layout from src/grid.rs
    view-mode: int,
    icon-size: length,
    cell-w: length,
    cell-h: length,
    lanes: int,
    // along the scroll axis
    content-len: length,
    // List: columns, scrolling sideways
    flows-columns: bool,
    text-below: bool,
    // the item size controls: icon views and Tiles
    resizable: bool,
    size-slider: float,
    can-smaller: bool,
    can-bigger: bool,
    sort-tooltip: string,
}

export component HeaderCell {
    in property <string> title;
    in property <bool> sorted;
    in property <bool> ascending;
    in property <TextHorizontalAlignment> align: left;
    // can be dragged to another place (all but Name)
    in property <bool> movable;
    // a dragged column would land at this cell's left / right edge
    in property <bool> drop-left;
    in property <bool> drop-right;
    callback clicked();
    callback resized(length);
    // right-click, in window coordinates
    callback menu(length, length);
    // dragging to reorder: the mouse at `x` in this cell; then let go, or the press was cancelled
    callback drag-moved(length);
    callback drag-ended();
    callback drag-cancelled();
    accessible-role: button;
    accessible-label: title;
    accessible-action-default => { clicked(); }
    Rectangle {
        background: touch.dragging ? Palette.foreground.with-alpha(0.12)
            : touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
    }
    if root.drop-left: Rectangle { x: 0; width: 2px; background: Palette.accent-background; }
    if root.drop-right: Rectangle { x: parent.width - 2px; width: 2px; background: Palette.accent-background; }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        Text {
            text: title;
            horizontal-alignment: root.align;
            vertical-alignment: center;
            overflow: elide;
            color: Palette.foreground.with-alpha(0.75);
        }
        Text {
            text: sorted ? (ascending ? "▲" : "▼") : "";
            font-size: 9px;
            vertical-alignment: center;
            color: Palette.foreground.with-alpha(0.6);
        }
    }
    touch := TouchArea {
        // a left press moved sideways: the column is being dragged
        property <bool> dragging;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                self.dragging = false;
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && self.dragging) {
                root.drag-ended();
            }
            if (event.kind == PointerEventKind.cancel && self.dragging) {
                self.dragging = false;
                root.drag-cancelled();
            }
        }
        moved => {
            if (root.movable && self.pressed && (self.dragging || abs(self.mouse-x - self.pressed-x) > 6px)) {
                self.dragging = true;
                root.drag-moved(self.mouse-x);
            }
        }
        clicked => {
            if (!self.dragging) {
                root.clicked();
            }
        }
    }
    // the right edge drags the width
    Rectangle {
        x: parent.width - 6px;
        width: 6px;
        Rectangle { x: 5px; width: 1px; background: Palette.border; }
        edge := TouchArea {
            mouse-cursor: col-resize;
            moved => { root.resized(root.width + self.mouse-x - self.pressed-x); }
        }
    }
}

export component SidePane {
    in property <int> side;
    in property <SideView> view;
    in property <[ColumnRow]> columns;
    in property <length> name-width: 300px;
    // Name plus the visible columns
    in property <length> columns-width: 800px;
    // the window's key handler has the focus (selection colors)
    in property <bool> keys-focused;
    // Ctrl (Cmd) is held down (the window tracks it): Ctrl+wheel goes to the view, not the list
    in-out property <bool> ctrl-held;
    // A tab or a column dragged to another place: the mouse's x in the tab bar or header. Each
    // tab (column) works out the gap it would land in while the mouse is over it; when let go
    // (`releasing`), the one under the mouse reports the move. Computed from the last position
    // when the release is handled, not from a `changed` handler that may not have run yet.
    property <bool> tab-dragging;
    property <bool> tab-releasing;
    property <int> tab-from;
    property <length> tab-drag-x;
    property <bool> col-dragging;
    property <bool> col-releasing;
    property <int> col-from;
    property <length> col-drag-x;
    in property <bool> dual;
    out property <length> row-height: 24px;
    // what a drag carries; the controller knows what was dragged (`drag-started`)
    in property <data-transfer> drag-data;
    // the dragged item's picture, under the mouse while dragging (`drag-started` makes it)
    in property <image> drag-image;

    // any press in this side makes it the active one
    callback activate(int);
    callback focus-keys();
    callback tree-resized(int, length);
    // window coordinates
    callback show-menu(length, length);
    // side, row, ctrl/cmd, shift
    callback row-pressed(int, int, bool, bool);
    callback row-activated(int, int);
    // side, row (-1: empty space)
    callback row-menu(int, int);
    callback empty-pressed(int);
    callback tree-clicked(int, int);
    callback tree-toggled(int, int);
    callback tree-menu(int, int) -> bool;
    // the eject button of a drive's row
    callback tree-eject(int, int);
    // side, ColumnId index
    callback sort-by(int, int);
    callback header-menu(int);
    // ColumnId index, width
    callback column-resized(int, length);
    callback tab-clicked(int, int);
    callback tab-closed(int, int);
    callback tab-new(int);
    callback tab-menu(int, int);
    callback crumb-clicked(int, int);
    callback address-entered(int, string);
    callback filter-edited(int, string);
    // a press on a row of a selection kept it (for dragging); a release without a drag selects the row
    callback row-released(int, int);
    // selection box: side, ctrl/cmd, shift
    callback box-start(int, bool, bool);
    // side, anchor x/y and mouse x/y in content coordinates (0,0: top left of the first item)
    callback box-moved(int, length, length, length, length);
    // side, whether a box was drawn (not just a click)
    callback box-ended(int, bool);
    // side, 0 list / 1 tree, row
    // side, area (0 list, 1 tree), row; the dragged element's rectangle in window coordinates
    // (its picture follows the mouse)
    callback drag-started(int, int, int, length, length, length, length);
    // side, 0 list / 1 tree, row under the mouse (-1: none); returns the row to mark, -1 when
    // accepted into the shown folder, -2 when refused
    callback drop-check(int, int, int) -> int;
    callback dropped(int, int, int);
    // the view and sort buttons' menus
    callback view-menu(int);
    callback sort-menu(int);
    // item size: side, -1 / +1; the slider's position (-1 … 1)
    callback size-step(int, int);
    callback size-slider-moved(int, float);
    callback size-slider-released(int);
    // a tab (side, index) or column (ColumnId index) dropped into a gap (0: before the first)
    callback tab-moved(int, int, int);
    callback column-moved(int, int);
    // the widest of `view.measure-names` in the items' font: List's column width
    callback list-measured(int, length);
    // Ctrl+wheel: side, delta (up positive)
    callback view-wheel(int, length);
    // the grid's size, and the slots it shows (first, count)
    callback grid-resized(int, length, length);
    callback grid-range(int, int, int);

    property <bool> focused: keys-focused && view.active;

    // measures List's names in the items' font (a text is as wide as its widest line)
    Rectangle {
        width: 0;
        height: 0;
        clip: true;
        visible: false;
        name-measure := Text { text: root.view.measure-names; }
    }
    property <length> widest-name: name-measure.preferred-width;
    changed widest-name => { root.list-measured(root.side, self.widest-name); }
    property <bool> details: view.view-mode == 5;
    // the shown file view's scroll offsets and size
    property <length> scroll-x: details ? list.content-x : grid.content-x;
    property <length> scroll-y: details ? list.content-y : grid.content-y;
    property <length> body-w: details ? list.visible-width : grid.visible-width;
    property <length> body-h: details ? list.visible-height : grid.visible-height;

    // ---- drop targets (-2: none) ----
    property <int> drop-row: -2;
    property <int> tree-drop-row: -2;

    // the row under the mouse in the area behind the list (rows' own touch areas cover only names)
    property <int> hover-row: bg-touch.has-hover && details ? list-row-at(bg-touch.mouse-y) : -1;

    // a pointer event on the Details list's background (or its Ctrl layer) at `x`, `y`
    function list-pointer(event: PointerEvent, x: length, y: length, at: Point) {
        if (event.kind == PointerEventKind.down) {
            root.activate(root.side);
            root.focus-keys();
        }
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
            root.box-press(x, y, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
            if (root.list-row-at(y) >= 0) {
                root.row-pressed(root.side, root.list-row-at(y), event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
            } else {
                root.empty-pressed(root.side);
            }
        }
        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
            root.box-release();
        }
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
            root.row-menu(root.side, root.list-row-at(y));
            root.show-menu(at.x + x, at.y + y);
        }
    }

    function list-clicked(y: length) {
        if (root.list-row-at(y) >= 0) {
            root.row-released(root.side, root.list-row-at(y));
        }
    }

    function list-double-clicked(y: length) {
        if (root.list-row-at(y) >= 0) {
            root.row-activated(root.side, root.list-row-at(y));
        }
    }

    function list-scroll(event: PointerScrollEvent) -> EventResult {
        if (event.modifiers.control || event.modifiers.meta) {
            root.view-wheel(root.side, event.delta-y);
            return accept;
        }
        return reject;
    }

    pure function list-row-at(y: length) -> int {
        return y - list.content-y < 0 ? -1 : floor((y - list.content-y) / row-height) < view.files.length
            ? floor((y - list.content-y) / row-height) : -1;
    }

    // the grid item at a point of the grid (-1: empty space); same rules as src/grid.rs
    pure function grid-index-at(x: length, y: length) -> int {
        let cx = x - grid.content-x - 6px;
        let cy = y - grid.content-y - 6px;
        if (cx < 0 || cy < 0 || view.cell-w <= 0 || view.cell-h <= 0) {
            return -1;
        }
        let col = floor(cx / view.cell-w);
        let row = floor(cy / view.cell-h);
        let i = view.flows-columns ? (row >= view.lanes ? -1 : col * view.lanes + row)
            : (col >= view.lanes ? -1 : row * view.lanes + col);
        return i < view.files.length ? i : -1;
    }

    pure function body-index-at(x: length, y: length) -> int {
        return details ? list-row-at(y) : grid-index-at(x, y);
    }

    pure function tree-row-at(y: length) -> int {
        return y - tree-list.content-y < 0 ? -1 : floor((y - tree-list.content-y) / 24px) < view.tree.length
            ? floor((y - tree-list.content-y) / 24px) : -1;
    }

    // ---- selection box: anchor in content coordinates, mouse in the list's ----
    property <bool> box-armed;
    property <bool> box-active;
    property <length> box-ax;
    property <length> box-ay;
    property <length> box-mx;
    property <length> box-my;
    // how far the mouse is past the edge along the scroll axis while drawing a box
    property <length> box-over: !box-active ? 0px
        : !details && view.flows-columns ? (box-mx < 0 ? box-mx : box-mx > body-w ? box-mx - body-w : 0px)
        : (box-my < 0 ? box-my : box-my > body-h ? box-my - body-h : 0px);

    function box-press(x: length, y: length, ctrl: bool, shift: bool) {
        box-armed = true;
        box-active = false;
        box-ax = x - scroll-x;
        box-ay = y - scroll-y;
        box-mx = x;
        box-my = y;
        root.box-start(root.side, ctrl, shift);
    }

    function box-drag(x: length, y: length) {
        if (!box-armed) {
            return;
        }
        box-mx = x;
        box-my = y;
        if (!box-active) {
            if (abs(x - (box-ax + scroll-x)) < 4px && abs(y - (box-ay + scroll-y)) < 4px) {
                return;
            }
            box-active = true;
        }
        box-update();
    }

    function box-update() {
        root.box-moved(root.side, box-ax, box-ay, box-mx - scroll-x, box-my - scroll-y);
    }

    function box-release() {
        if (box-armed) {
            root.box-ended(root.side, box-active);
        }
        box-armed = false;
        box-active = false;
    }

    pure function cell(row: FileRow, col: int) -> string {
        return col == 1 ? row.size : col == 2 ? row.kind : col == 3 ? row.modified : col == 4 ? row.created
            : col == 5 ? row.accessed : col == 6 ? row.extension : col == 7 ? row.attributes : row.name;
    }

    // ---- requests from Rust ----
    property <int> ensure-seq: view.ensure-seq;
    changed ensure-seq => {
        if (!details) {
            grid-ensure(view.ensure-row);
        } else if (view.ensure-row >= 0) {
            if (view.ensure-row * row-height < -list.content-y) {
                list.content-y = -view.ensure-row * row-height;
            } else if ((view.ensure-row + 1) * row-height > -list.content-y + list.visible-height) {
                list.content-y = -((view.ensure-row + 1) * row-height - list.visible-height);
            }
        }
    }
    property <int> top-seq: view.top-seq;
    changed top-seq => {
        list.content-y = 0;
        list.content-x = 0;
        grid.content-x = 0;
        grid.content-y = 0;
    }

    // scrolls just enough to show item `r` of the grid
    function grid-ensure(r: int) {
        if (r < 0 || grid.along <= 0) {
            return;
        }
        let start = 6px + floor(r / max(1, view.lanes)) * grid.along;
        if (view.flows-columns) {
            if (start - 6px < -grid.content-x) {
                grid.content-x = -(start - 6px);
            } else if (start + grid.along + 6px > -grid.content-x + grid.visible-width) {
                grid.content-x = -min(max(0px, grid.content-width - grid.visible-width), start + grid.along + 6px - grid.visible-width);
            }
        } else {
            if (start - 6px < -grid.content-y) {
                grid.content-y = -(start - 6px);
            } else if (start + grid.along + 6px > -grid.content-y + grid.visible-height) {
                grid.content-y = -min(max(0px, grid.content-height - grid.visible-height), start + grid.along + 6px - grid.visible-height);
            }
        }
    }
    property <bool> editing;
    property <int> edit-seq: view.edit-seq;
    changed edit-seq => {
        editing = true;
        address-field.text = view.address;
        address-field.focus();
        address-field.select-all();
    }
    property <bool> address-focused: address-field.has-focus;
    changed address-focused => {
        if (!address-focused) {
            editing = false;
        }
    }
    property <int> filter-seq: view.filter-seq;
    changed filter-seq => {
        filter-field.focus();
        filter-field.select-all();
    }
    // the slider follows the size (buttons, keys, another view); its own moves come from the user
    property <float> slider-pos: view.size-slider;
    changed slider-pos => { size-slider.value = slider-pos; }
    property <string> filter-text: view.filter;
    changed filter-text => {
        if (filter-field.text != filter-text) {
            filter-field.text = filter-text;
        }
    }
    // Row the tree should scroll to (3 rows below the top, unless already in view); -1 once done.
    // Re-applied when the list's heights change: right after the rows change it hasn't measured
    // them yet, and the scroll would be clamped (the list does that a moment later, too).
    property <int> tree-target: -1;
    property <int> tree-seq: view.tree-seq;
    changed tree-seq => {
        tree-target = view.tree-row;
        apply-tree-scroll();
    }

    function apply-tree-scroll() {
        if (tree-target < 0) {
            return;
        }
        if (tree-target * 24px < -tree-list.content-y || (tree-target + 1) * 24px > -tree-list.content-y + tree-list.visible-height) {
            tree-list.content-y = -max(0px, (tree-target - 3) * 24px);
        }
        // done once in view, and only once the list has measured rows down to it: until then
        // the list clamps the scroll back
        if (tree-target * 24px >= -tree-list.content-y && (tree-target + 1) * 24px <= -tree-list.content-y + tree-list.visible-height
                && (tree-target + 1) * 24px <= tree-list.content-height) {
            tree-target = -1;
        }
    }

    HorizontalLayout {
        // ---- folder tree ----
        VerticalLayout {
            // the file list keeps a usable width in a narrow window; the tree gives way
            width: max(80px, min(root.view.tree-width, root.width - 265px));
            Rectangle {
            tree-list := ListView {
                changed visible-height => { root.apply-tree-scroll(); }
                changed content-height => { root.apply-tree-scroll(); }
                for row[i] in root.view.tree: Rectangle {
                    height: 24px;
                    accessible-role: list-item;
                    accessible-label: row.name;
                    Rectangle {
                        x: 4px;
                        width: parent.width - 8px;
                        border-radius: 4px;
                        background: i == root.tree-drop-row ? Palette.accent-background.with-alpha(0.3)
                            : row.current ? Palette.accent-background.with-alpha(0.18)
                            : tree-touch.has-hover && !row.header ? Palette.foreground.with-alpha(0.06) : transparent;
                        // the right-clicked row is outlined while its menu is open
                        border-width: row.current || i == root.tree-drop-row || i == root.view.tree-menu-row ? 1px : 0px;
                        border-color: i == root.view.tree-menu-row ? Palette.accent-background : Palette.accent-background.with-alpha(0.6);
                    }
                    DragArea {
                        enabled: row.draggable;
                        data: root.drag-data;
                        allow-move: true;
                        allow-copy: true;
                        drag-image: root.drag-image;
                        drag-image-offset-x: round(tree-touch.pressed-x / 1px);
                        drag-image-offset-y: round(tree-touch.pressed-y / 1px);
                        changed dragging => {
                            if (self.dragging) {
                                root.drag-started(root.side, 1, i, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                            }
                        }
                    tree-touch := TouchArea {
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                root.activate(root.side);
                            }
                            // right-click: a menu, never a navigation
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                // the keys come back here when the menu closes (that ends its outline)
                                root.focus-keys();
                                if (root.tree-menu(root.side, i)) {
                                    root.show-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        clicked => {
                            if (!row.header) {
                                root.tree-clicked(root.side, i);
                            }
                        }
                        double-clicked => {
                            if (row.expandable) {
                                root.tree-toggled(root.side, i);
                            }
                        }
                    }
                    }
                    HorizontalLayout {
                        padding-left: 6px + row.depth * 14px;
                        padding-right: 6px;
                        spacing: 4px;
                        alignment: start;
                        Rectangle {
                            width: 16px;
                            if row.expandable: Path {
                                width: 14px;
                                height: 14px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: row.expanded ? Icons.chevron-down : Icons.chevron-right;
                                fill: Palette.foreground.with-alpha(0.6);
                            }
                            TouchArea {
                                enabled: row.expandable;
                                clicked => { root.tree-toggled(root.side, i); }
                            }
                        }
                        if !row.header: VerticalLayout {
                            alignment: center;
                            FileIcon { kind: row.icon; }
                        }
                        Text {
                            text: row.name;
                            vertical-alignment: center;
                            overflow: elide;
                            // the free space gives way first
                            min-width: row.extra != "" ? min(self.preferred-width, 110px) : 0px;
                            font-weight: row.header || row.on-path ? 600 : 400;
                            color: row.header ? Palette.foreground.with-alpha(0.6) : Palette.foreground;
                            font-size: row.header ? 11px : 13px;
                        }
                        // before the free space, which gets cut off first
                        if row.ejectable: Rectangle {
                            width: 20px;
                            accessible-role: button;
                            accessible-label: "Eject (safely remove)";
                            accessible-enabled: !row.ejecting;
                            accessible-action-default => { if (!row.ejecting) { root.tree-eject(root.side, i); } }
                            border-radius: 3px;
                            background: eject-touch.has-hover && !row.ejecting ? Palette.foreground.with-alpha(0.1) : transparent;
                            Path {
                                width: 14px;
                                height: 14px;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: Icons.eject;
                                fill: Palette.foreground.with-alpha(row.ejecting ? 0.3 : 0.7);
                            }
                            eject-touch := TouchArea {
                                enabled: !row.ejecting;
                                clicked => { root.tree-eject(root.side, i); }
                            }
                        }
                        if row.extra != "": Text {
                            min-width: 0px;
                            text: row.extra;
                            vertical-alignment: center;
                            overflow: elide;
                            font-size: 11px;
                            color: Palette.foreground.with-alpha(0.55);
                        }
                    }
                }
            }
            // drops onto a folder of the tree
            DropArea {
                can-drop(event) => {
                    root.tree-drop-row = root.drop-check(root.side, 1, root.tree-row-at(event.position.y));
                    return root.tree-drop-row >= 0 ? DragAction.move : DragAction.none;
                }
                dropped(event) => {
                    root.tree-drop-row = -2;
                    root.dropped(root.side, 1, root.tree-row-at(event.position.y));
                    return DragAction.copy;
                }
                changed has-drag => {
                    if (!self.has-drag) {
                        root.tree-drop-row = -2;
                    }
                }
            }
            }
        }

        // ---- splitter ----
        Rectangle {
            width: 5px;
            background: splitter.has-hover || splitter.pressed ? Palette.accent-background.with-alpha(0.3) : transparent;
            Rectangle { x: 2px; width: 1px; background: Palette.border; }
            splitter := TouchArea {
                mouse-cursor: col-resize;
                moved => {
                    root.tree-resized(root.side, clamp(root.view.tree-width + self.mouse-x - self.pressed-x, 120px, max(120px, root.width - 260px)));
                }
            }
        }

        VerticalLayout {
            min-width: 250px;
            // ---- tab bar ----
            Rectangle {
                height: 32px;
                background: Palette.alternate-background;
                // the active side of two is marked
                if root.dual && root.view.active: Rectangle { y: 0; height: 2px; background: Palette.accent-background; }
                Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                HorizontalLayout {
                    padding-left: 4px;
                    padding-top: 3px;
                    spacing: 2px;
                    alignment: start;
                    for tab[t] in root.view.tabs: Rectangle {
                        // the gap a dragged tab would land in, while the mouse is over this one (or the
                        // spacing after it; the first and last also take everything beyond them)
                        property <int> slot: (root.tab-dragging || root.tab-releasing)
                            && (t == 0 || root.tab-drag-x >= self.x)
                            && (t == root.view.tabs.length - 1 || root.tab-drag-x < self.x + self.width + 2px)
                            ? (root.tab-drag-x < self.x + self.width / 2 ? t : t + 1) : -1;
                        property <int> drop-now: root.tab-releasing ? self.slot : -1;
                        changed drop-now => {
                            if (self.drop-now >= 0) {
                                let gap = self.drop-now; // resetting `releasing` changes drop-now
                                root.tab-releasing = false;
                                root.tab-moved(root.side, root.tab-from, gap);
                            }
                        }
                        min-width: 80px;
                        max-width: 200px;
                        preferred-width: tab-layout.preferred-width;
                        border-radius: 4px;
                        background: tab.active ? Palette.background : tab-touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                        border-width: tab.active ? 1px : 0px;
                        border-color: Palette.border;
                        accessible-role: AccessibleRole.tab;
                        accessible-label: tab.title;
                        accessible-item-selected: tab.active;
                        accessible-action-default => { root.tab-clicked(root.side, t); }
                        if root.tab-dragging && slot >= 0: Rectangle {
                            x: slot == t ? -2px : parent.width;
                            width: 2px;
                            background: Palette.accent-background;
                        }
                        tab-touch := TouchArea {
                            // a left press moved sideways: the tab is being dragged to another place
                            property <bool> dragging;
                            moved => {
                                if (self.pressed && root.view.tabs.length > 1 && (self.dragging || abs(self.mouse-x - self.pressed-x) > 6px)) {
                                    self.dragging = true;
                                    root.tab-dragging = true;
                                    root.tab-drag-x = parent.x + self.mouse-x;
                                }
                            }
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    self.dragging = false;
                                }
                                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && self.dragging) {
                                    root.tab-from = t;
                                    root.tab-dragging = false;
                                    root.tab-releasing = true;
                                }
                                if (event.kind == PointerEventKind.cancel && self.dragging) {
                                    self.dragging = false;
                                    root.tab-dragging = false;
                                }
                                if (event.kind == PointerEventKind.down) {
                                    root.activate(root.side);
                                }
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    root.tab-menu(root.side, t);
                                    root.show-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.middle) {
                                    root.tab-closed(root.side, t);
                                }
                            }
                            clicked => {
                                if (!self.dragging) {
                                    root.tab-clicked(root.side, t);
                                }
                            }
                        }
                        tab-layout := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 4px;
                            spacing: 4px;
                            Text {
                                text: tab.title;
                                vertical-alignment: center;
                                overflow: elide;
                                font-weight: tab.active ? 600 : 400;
                            }
                            ToolButton {
                                width: 20px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                icon: Icons.close;
                                tooltip: "Close tab";
                                enabled: root.view.tabs.length > 1;
                                clicked => { root.tab-closed(root.side, t); }
                            }
                        }
                    }
                    ToolButton {
                        width: 26px;
                        height: 26px;
                        icon: Icons.plus;
                        tooltip: "New tab (Ctrl+T)";
                        clicked => { root.tab-new(root.side); }
                    }
                }
            }

            // ---- address bar + filter ----
            HorizontalLayout {
                padding: 5px;
                spacing: 6px;
                height: 42px;
                Rectangle {
                    min-width: 60px;
                    horizontal-stretch: 1;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Palette.border;
                    background: Palette.control-background;
                    clip: true;
                    accessible-role: groupbox;
                    accessible-label: "Address";
                    // a click next to the crumbs edits the path
                    TouchArea {
                        clicked => {
                            root.activate(root.side);
                            root.editing = true;
                            address-field.text = root.view.address;
                            address-field.focus();
                            address-field.select-all();
                        }
                    }
                    crumbs := HorizontalLayout {
                        visible: !root.editing;
                        // the end of a long path stays visible
                        x: min(4px, parent.width - self.preferred-width - 4px);
                        width: self.preferred-width;
                        alignment: start;
                        for crumb[c] in root.view.crumbs: HorizontalLayout {
                            if c > 0: Text {
                                text: "›";
                                vertical-alignment: center;
                                color: Palette.foreground.with-alpha(0.5);
                            }
                            Rectangle {
                                width: crumb-layout.preferred-width;
                                border-radius: 3px;
                                background: crumb-touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
                                accessible-role: button;
                                accessible-label: crumb.drive ? "File System" : crumb.label;
                                accessible-action-default => { root.crumb-clicked(root.side, c); }
                                crumb-touch := TouchArea {
                                    clicked => {
                                        root.activate(root.side);
                                        root.crumb-clicked(root.side, c);
                                    }
                                }
                                crumb-layout := HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 4px;
                                    if crumb.drive: VerticalLayout {
                                        alignment: center;
                                        FileIcon { kind: 21; width: 16px; height: 16px; }
                                    }
                                    if crumb.label != "": Text {
                                        text: crumb.label;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    address-field := LineEdit {
                        visible: root.editing;
                        min-width: 0px;
                        accessible-label: "Address field";
                        accepted(text) => {
                            root.editing = false;
                            root.address-entered(root.side, text);
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.editing = false;
                                root.focus-keys();
                                return EventResult.accept;
                            }
                            return EventResult.reject;
                        }
                    }
                }
                ToolButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.view(root.view.view-mode);
                    tooltip: "View (Ctrl+Shift+1…8, Ctrl+wheel)";
                    clicked => {
                        root.activate(root.side);
                        root.view-menu(root.side);
                        root.show-menu(self.absolute-position.x, self.absolute-position.y + self.height);
                    }
                }
                ToolButton {
                    y: (parent.height - self.height) / 2;
                    icon: root.view.sort-ascending ? Icons.sort-ascending : Icons.sort-descending;
                    tooltip: root.view.sort-tooltip;
                    clicked => {
                        root.activate(root.side);
                        root.sort-menu(root.side);
                        root.show-menu(self.absolute-position.x, self.absolute-position.y + self.height);
                    }
                }
                filter-field := LineEdit {
                    // narrower in a narrow side
                    min-width: 70px;
                    preferred-width: 170px;
                    max-width: 170px;
                    horizontal-stretch: 0;
                    placeholder-text: "Filter (*, ?)";
                    accessible-label: "Filter";
                    edited(text) => {
                        root.activate(root.side);
                        root.filter-edited(root.side, text);
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            self.text = "";
                            root.filter-edited(root.side, "");
                            root.focus-keys();
                            return EventResult.accept;
                        }
                        if (event.text == Key.Return || event.text == Key.DownArrow) {
                            root.focus-keys();
                            return EventResult.accept;
                        }
                        return EventResult.reject;
                    }
                }
            }
            Rectangle { height: 1px; background: Palette.border; }

            // ---- details list ----
            Rectangle {
                height: root.details ? 26px : 0px;
                visible: root.details;
                clip: true;
                // right-click: which columns to show
                TouchArea {
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                            root.activate(root.side);
                            root.header-menu(root.side);
                            root.show-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
                HorizontalLayout {
                    x: list.content-x;
                    width: max(root.columns-width, list.visible-width);
                    alignment: start;
                    HeaderCell {
                        // a column dropped on Name (or left of it) goes right after it
                        property <int> slot: (root.col-dragging || root.col-releasing) && root.col-drag-x < self.x + self.width ? 0 : -1;
                        property <int> drop-now: root.col-releasing ? self.slot : -1;
                        changed drop-now => {
                            if (self.drop-now >= 0) {
                                let gap = self.drop-now; // resetting `releasing` changes drop-now
                                root.col-releasing = false;
                                root.column-moved(root.col-from, gap);
                            }
                        }
                        drop-right: root.col-dragging && self.slot == 0;
                        width: root.name-width;
                        title: "Name";
                        sorted: root.view.sort-column == 0;
                        ascending: root.view.sort-ascending;
                        clicked => { root.activate(root.side); root.sort-by(root.side, 0); }
                        resized(w) => { root.column-resized(0, w); }
                        menu(x, y) => { root.activate(root.side); root.header-menu(root.side); root.show-menu(x, y); }
                    }
                    for col[ci] in root.columns: HeaderCell {
                        // the gap a dragged column would land in, while the mouse is over this one (the
                        // last one also takes everything right of it)
                        property <int> slot: (root.col-dragging || root.col-releasing) && root.col-drag-x >= self.x
                            && (ci == root.columns.length - 1 || root.col-drag-x < self.x + self.width)
                            ? (root.col-drag-x < self.x + self.width / 2 ? ci : ci + 1) : -1;
                        property <int> drop-now: root.col-releasing ? self.slot : -1;
                        changed drop-now => {
                            if (self.drop-now >= 0) {
                                let gap = self.drop-now; // resetting `releasing` changes drop-now
                                root.col-releasing = false;
                                root.column-moved(root.col-from, gap);
                            }
                        }
                        movable: true;
                        drop-left: root.col-dragging && self.slot == ci && ci > 0;
                        drop-right: root.col-dragging && self.slot == ci + 1;
                        drag-moved(x) => {
                            root.col-dragging = true;
                            root.col-drag-x = self.x + x;
                        }
                        drag-ended => {
                            root.col-from = col.col;
                            root.col-dragging = false;
                            root.col-releasing = true;
                        }
                        drag-cancelled => { root.col-dragging = false; }
                        width: col.width;
                        title: col.title;
                        align: col.align-right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                        sorted: root.view.sort-column == col.col;
                        ascending: root.view.sort-ascending;
                        clicked => { root.activate(root.side); root.sort-by(root.side, col.col); }
                        resized(w) => { root.column-resized(col.col, w); }
                        menu(x, y) => { root.activate(root.side); root.header-menu(root.side); root.show-menu(x, y); }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
            }
            Rectangle {
                // Presses on a row past its icon and name, and on empty space, pass through the
                // list to here. This area is never rebuilt while scrolling, so a selection box keeps
                // getting the mouse after its first row scrolled out of view (a row's own touch area
                // would be gone, and the release with it).
                bg-touch := TouchArea {
                    pointer-event(event) => { root.list-pointer(event, self.mouse-x, self.mouse-y, self.absolute-position); }
                    moved => { root.box-drag(self.mouse-x, self.mouse-y); }
                    clicked => { root.list-clicked(self.mouse-y); }
                    double-clicked => { root.list-double-clicked(self.mouse-y); }
                    // reaches here only where the list has nothing to scroll; names take it always
                    scroll-event(event) => { return root.list-scroll(event); }
                }
                list := ListView {
                    // no sideways scroll bar under the grid views
                    content-width: root.details ? max(root.columns-width, self.visible-width) : self.visible-width;
                    // empty in the grid views: no hidden rows to build or find
                    for row[i] in root.view.list-files: file-row := Rectangle {
                        height: root.row-height;
                        width: max(root.columns-width, list.visible-width);
                        accessible-role: list-item;
                        accessible-label: row.name;
                        accessible-item-selected: row.selected;
                        background: i == root.drop-row ? Palette.accent-background.with-alpha(0.3)
                            : row.selected ? Palette.selection-background.with-alpha(root.focused ? 1.0 : 0.45)
                            : row-touch.has-hover || i == root.hover-row ? Palette.foreground.with-alpha(0.05) : transparent;
                        border-width: (row.current && root.focused) || i == root.drop-row ? 1px : 0px;
                        border-color: Palette.accent-background;
                        // files are dragged by their icon and name (with a little slack); the rest
                        // of the row belongs to the area behind the list (selection box)
                        row-drag := DragArea {
                            x: 0;
                            width: name-text.x + min(name-text.width, name-text.preferred-width) + 4px;
                            height: parent.height;
                            enabled: !root.box-armed;
                            data: root.drag-data;
                            allow-move: true;
                            allow-copy: true;
                            drag-image: root.drag-image;
                            drag-image-offset-x: round(row-touch.pressed-x / 1px);
                            drag-image-offset-y: round(row-touch.pressed-y / 1px);
                            changed dragging => {
                                if (self.dragging) {
                                    root.drag-started(root.side, 0, i, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                                }
                            }
                        row-touch := TouchArea {
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    root.activate(root.side);
                                    root.focus-keys();
                                }
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    root.row-pressed(root.side, i, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                                }
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    root.row-menu(root.side, i);
                                    root.show-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                            clicked => { root.row-released(root.side, i); }
                            double-clicked => { root.row-activated(root.side, i); }
                            scroll-event(event) => {
                                if (event.modifiers.control || event.modifiers.meta) {
                                    root.view-wheel(root.side, event.delta-y);
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        }
                        HorizontalLayout {
                            property <color> fg: row.selected && root.focused ? Palette.selection-foreground : Palette.foreground;
                            alignment: start;
                            HorizontalLayout {
                                width: root.name-width;
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    FileIcon { kind: row.icon; dimmed: row.hidden; }
                                }
                                name-text := Text {
                                    text: row.name;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    color: fg;
                                }
                            }
                            // same widths and 6px insets as the header cells, so text lines up
                            for col in root.columns: HorizontalLayout {
                                width: col.width;
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: root.cell(row, col.col);
                                    horizontal-alignment: col.align-right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    color: fg.with-alpha(0.8);
                                }
                            }
                        }
                    }
                }
                // While Ctrl is held, this lies over the Details list and takes the wheel before the
                // list scrolls (Ctrl+wheel changes the view anywhere over it, as in Explorer). Its
                // presses do what the area behind the list does; a press in progress keeps it.
                ctrl-touch := TouchArea {
                    property <bool> grabbing;
                    enabled: root.details && (root.ctrl-held || self.grabbing);
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.move && !event.modifiers.control && !event.modifiers.meta && !self.grabbing) {
                            root.ctrl-held = false; // released while the window didn't see it
                            return;
                        }
                        if (event.kind == PointerEventKind.down) {
                            self.grabbing = true;
                        }
                        if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            self.grabbing = false;
                        }
                        if (event.kind == PointerEventKind.cancel) {
                            root.box-release();
                        }
                        root.list-pointer(event, self.mouse-x, self.mouse-y, self.absolute-position);
                    }
                    moved => { root.box-drag(self.mouse-x, self.mouse-y); }
                    clicked => { root.list-clicked(self.mouse-y); }
                    double-clicked => { root.list-double-clicked(self.mouse-y); }
                    scroll-event(event) => { return root.list-scroll(event); }
                }
                // ---- the grid views: only the slots in view exist, reused while scrolling ----
                grid := ScrollView {
                    visible: !root.details;
                    property <bool> cols: root.view.flows-columns;
                    property <length> along: cols ? root.view.cell-w : root.view.cell-h;
                    property <length> offset: cols ? -self.content-x : -self.content-y;
                    property <int> first: along > 0 ? max(0, floor((offset - 6px) / along)) * root.view.lanes : 0;
                    property <int> slots: root.view.slots.length;
                    content-width: cols ? max(root.view.content-len, self.visible-width) : self.visible-width;
                    content-height: cols ? self.visible-height : max(root.view.content-len, self.visible-height);
                    init => { root.grid-resized(root.side, self.visible-width, self.visible-height); }
                    changed visible-width => { root.grid-resized(root.side, self.visible-width, self.visible-height); }
                    changed visible-height => { root.grid-resized(root.side, self.visible-width, self.visible-height); }
                    changed first => { root.grid-range(root.side, self.first, self.slots); }
                    changed slots => { root.grid-range(root.side, self.first, self.slots); }
                    // empty space: selection box, the folder's menu, Ctrl+wheel
                    TouchArea {
                        width: grid.content-width;
                        height: grid.content-height;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                root.activate(root.side);
                                root.focus-keys();
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                root.box-press(grid.content-x + self.mouse-x, grid.content-y + self.mouse-y,
                                    event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                                root.empty-pressed(root.side);
                            }
                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                                root.box-release();
                            }
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                root.row-menu(root.side, -1);
                                root.show-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                        moved => { root.box-drag(grid.content-x + self.mouse-x, grid.content-y + self.mouse-y); }
                        scroll-event(event) => {
                            if (event.modifiers.control || event.modifiers.meta) {
                                root.view-wheel(root.side, event.delta-y);
                                return accept;
                            }
                            return reject;
                        }
                    }
                    // a model from Rust that only changes length: an int count here would be a new
                    // model on every update, and every slot would be built again (losing clicks)
                    for k in root.view.slots: slot := Rectangle {
                        property <int> idx: grid.first + k;
                        property <FileRow> item: root.view.files[idx];
                        property <int> line: floor(idx / max(1, root.view.lanes));
                        property <int> lane: idx - line * max(1, root.view.lanes);
                        visible: idx < root.view.files.length;
                        x: 6px + (grid.cols ? line * root.view.cell-w : lane * root.view.cell-w);
                        y: 6px + (grid.cols ? lane * root.view.cell-h : line * root.view.cell-h);
                        width: root.view.cell-w;
                        height: root.view.cell-h;
                        accessible-role: list-item;
                        accessible-label: item.name;
                        accessible-item-selected: item.selected;
                        DragArea {
                            enabled: !root.box-armed;
                            data: root.drag-data;
                            allow-move: true;
                            allow-copy: true;
                            drag-image: root.drag-image;
                            drag-image-offset-x: round(slot-touch.pressed-x / 1px);
                            drag-image-offset-y: round(slot-touch.pressed-y / 1px);
                            changed dragging => {
                                if (self.dragging) {
                                    root.drag-started(root.side, 0, slot.idx, self.absolute-position.x, self.absolute-position.y, self.width, self.height);
                                }
                            }
                        slot-touch := TouchArea {
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    root.activate(root.side);
                                    root.focus-keys();
                                }
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    root.row-pressed(root.side, slot.idx, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                                }
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    root.row-menu(root.side, slot.idx);
                                    root.show-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                            clicked => { root.row-released(root.side, slot.idx); }
                            double-clicked => { root.row-activated(root.side, slot.idx); }
                            scroll-event(event) => {
                                if (event.modifiers.control || event.modifiers.meta) {
                                    root.view-wheel(root.side, event.delta-y);
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        }
                        GridItem {
                            width: parent.width;
                            height: parent.height;
                            mode: root.view.view-mode;
                            icon-size: root.view.icon-size;
                            text-below: root.view.text-below;
                            name: slot.item.name;
                            kind: slot.item.kind;
                            size: slot.item.size;
                            modified: slot.item.modified;
                            icon: slot.item.icon;
                            hidden: slot.item.hidden;
                            thumb: slot.item.thumb;
                            selected: slot.item.selected;
                            current: slot.item.current;
                            focused: root.focused;
                            hover: slot-touch.has-hover;
                            drop-target: slot.idx == root.drop-row;
                        }
                    }
                }
                // the selection box, clipped to the file view
                if root.box-active: Rectangle {
                    property <length> x1: clamp(root.box-ax + root.scroll-x, 0px, root.body-w);
                    property <length> y1: clamp(root.box-ay + root.scroll-y, 0px, root.body-h);
                    property <length> x2: clamp(root.box-mx, 0px, root.body-w);
                    property <length> y2: clamp(root.box-my, 0px, root.body-h);
                    x: min(x1, x2);
                    y: min(y1, y2);
                    width: abs(x2 - x1);
                    height: abs(y2 - y1);
                    background: Palette.accent-background.with-alpha(0.15);
                    border-width: 1px;
                    border-color: Palette.accent-background;
                    accessible-role: groupbox;
                    accessible-label: "Selection box";
                }
                // past the edge while drawing a box: scroll (sideways in List)
                Timer {
                    interval: 30ms;
                    running: root.box-over != 0px;
                    triggered => {
                        let step = clamp(root.box-over / 2, -40px, 40px);
                        if (root.details) {
                            list.content-y = clamp(list.content-y - step, min(0px, list.visible-height - list.content-height), 0px);
                        } else if (grid.cols) {
                            grid.content-x = clamp(grid.content-x - step, min(0px, grid.visible-width - grid.content-width), 0px);
                        } else {
                            grid.content-y = clamp(grid.content-y - step, min(0px, grid.visible-height - grid.content-height), 0px);
                        }
                        root.box-update();
                    }
                }
                // drops onto a folder row or item, or anywhere else into the shown folder
                DropArea {
                    can-drop(event) => {
                        root.drop-row = root.drop-check(root.side, 0, root.body-index-at(event.position.x, event.position.y));
                        return root.drop-row >= -1 ? DragAction.move : DragAction.none;
                    }
                    dropped(event) => {
                        root.drop-row = -2;
                        root.dropped(root.side, 0, root.body-index-at(event.position.x, event.position.y));
                        return DragAction.copy;
                    }
                    changed has-drag => {
                        if (!self.has-drag) {
                            root.drop-row = -2;
                        }
                    }
                }
            }
            if root.view.files.length == 0 && root.view.message != "": Text {
                text: root.view.message;
                horizontal-alignment: center;
                color: Palette.foreground.with-alpha(0.6);
                height: 40px;
            }

            // ---- status line ----
            Rectangle { height: 1px; background: Palette.border; }
            Rectangle {
                height: 24px;
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 4px;
                    spacing: 2px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.view.status;
                        vertical-alignment: center;
                        overflow: elide;
                        color: Palette.foreground.with-alpha(0.75);
                        font-size: 12px;
                        accessible-role: text;
                        accessible-label: "Status";
                        accessible-value: root.view.status;
                    }
                    // item size: icon views and Tiles only
                    if root.view.resizable: ToolButton {
                        width: 22px;
                        height: 22px;
                        y: 1px;
                        icon: Icons.minus;
                        tooltip: "Smaller items (Ctrl+−)";
                        enabled: root.view.can-smaller;
                        clicked => { root.activate(root.side); root.size-step(root.side, -1); }
                    }
                    size-slider := Slider {
                        visible: root.view.resizable;
                        width: root.view.resizable ? 110px : 0px;
                        minimum: -1;
                        maximum: 1;
                        accessible-label: "Item size";
                        init => { self.value = root.slider-pos; }
                        changed(v) => {
                            root.activate(root.side);
                            root.size-slider-moved(root.side, v);
                        }
                        // two quick ones: a double-click, back to the view's own size
                        released => {
                            root.size-slider-released(root.side);
                            root.focus-keys();
                        }
                    }
                    if root.view.resizable: ToolButton {
                        width: 22px;
                        height: 22px;
                        y: 1px;
                        icon: Icons.plus;
                        tooltip: "Bigger items (Ctrl++)";
                        enabled: root.view.can-bigger;
                        clicked => { root.activate(root.side); root.size-step(root.side, 1); }
                    }
                }
            }
        }
    }
}
