// fileEm main window: toolbar with address bar, folder tree, details list, status line.
// All commands and keys go to Rust (see src/app.rs); this file only lays out and draws.

import { Button, LineEdit, ScrollView, ListView, Palette } from "std-widgets.slint";
import { Icons, FileIcon } from "icons.slint";
export { ProgressWindow, OpRow } from "progress.slint";
export { PropertiesWindow, PropLine } from "properties.slint";

export struct FileRow {
    name: string,
    size: string,
    kind: string,
    modified: string,
    // Category as an int: see icon-path / icon-color below and src/app.rs `icon_of`.
    icon: int,
    selected: bool,
    current: bool,
    hidden: bool,
}

// One item of a right-click menu (src/menu.rs); `id` is handed back to `menu-activated`.
export struct MenuRow {
    id: int,
    title: string,
    enabled: bool,
    checkable: bool,
    checked: bool,
}

export struct TreeRow {
    name: string,
    depth: int,
    // Section titles ("Quick access", "This computer") are not folders.
    header: bool,
    expandable: bool,
    expanded: bool,
    // Showing the tab's folder (boxed), or one of its parents (bold).
    current: bool,
    on-path: bool,
    icon: int,
}

component ToolButton {
    in property <string> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <bool> checked;
    callback clicked();
    width: 30px;
    height: 30px;
    accessible-role: button;
    accessible-label: tooltip;
    accessible-action-default => { if (enabled) { clicked(); } }
    Rectangle {
        border-radius: 4px;
        background: touch.pressed && enabled ? Palette.foreground.with-alpha(0.16)
            : checked ? Palette.accent-background.with-alpha(0.22)
            : touch.has-hover && enabled ? Palette.foreground.with-alpha(0.08) : transparent;
    }
    Path {
        width: 18px;
        height: 18px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: icon;
        fill: Palette.foreground;
        opacity: enabled ? 1.0 : 0.35;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component HeaderCell {
    in property <string> title;
    in property <bool> sorted;
    in property <bool> ascending;
    in property <TextHorizontalAlignment> align: left;
    callback clicked();
    accessible-role: button;
    accessible-label: title;
    accessible-action-default => { clicked(); }
    Rectangle {
        background: touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        Text {
            text: title;
            horizontal-alignment: root.align;
            vertical-alignment: center;
            overflow: elide;
            color: Palette.foreground.with-alpha(0.75);
        }
        Text {
            text: sorted ? (ascending ? "▲" : "▼") : "";
            font-size: 9px;
            vertical-alignment: center;
            color: Palette.foreground.with-alpha(0.6);
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    in property <string> window-title: "fileEm";
    title: window-title;
    preferred-width: 1100px;
    preferred-height: 700px;
    min-width: 480px;
    min-height: 320px;
    background: Palette.background;
    default-font-size: 13px;

    in-out property <string> address;
    in property <[FileRow]> files;
    in property <[TreeRow]> tree;
    in property <string> status;
    in property <string> message;
    in property <int> sort-column;
    in property <bool> sort-ascending: true;
    in property <bool> show-hidden;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> can-up;
    in-out property <length> tree-width: 240px;
    out property <length> row-height: 24px;

    callback back();
    callback forward();
    callback up();
    callback refresh();
    callback toggle-hidden();
    callback navigate-address(string);
    callback sort-by(int);
    // index, ctrl/cmd, shift
    callback row-pressed(int, bool, bool);
    callback row-activated(int);
    callback tree-clicked(int);
    callback tree-toggled(int);
    // the directory watcher saw changes in the shown folder (token: which watch)
    callback dir-changed(int);

    // ---- right-click menus (built by src/menu.rs on each request) ----
    // sections are separated by lines; the Sort by and New submenus follow section 1
    in property <[MenuRow]> menu-s0;
    in property <[MenuRow]> menu-s1;
    in property <[MenuRow]> menu-s2;
    in property <[MenuRow]> menu-s3;
    in property <[MenuRow]> menu-s4;
    in property <[MenuRow]> menu-s5;
    in property <[MenuRow]> menu-sort;
    in property <[MenuRow]> menu-new;
    // a right-click on a row (-1: empty space): selects as needed and builds the menu
    callback row-menu(int);
    // a right-click in the tree: builds its menu, false when the row has none (headers)
    callback tree-menu(int) -> bool;
    // the keyboard's menu key: builds the selection's menu, returns the focused row (or -1)
    callback keyboard-menu() -> int;
    callback menu-activated(int);

    // ---- dialog (drawn over the window; see src/app.rs `Dialog`) ----
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-message;
    // a name field (rename, new folder), with the part before the extension selected
    in property <bool> dialog-input;
    in-out property <string> dialog-text;
    in property <int> dialog-select-end;
    in property <string> dialog-error;
    // lines of a list (operation errors)
    in property <[string]> dialog-lines;
    in property <string> dialog-ok: "OK";
    in property <bool> dialog-can-cancel: true;
    callback dialog-accepted(string);
    callback dialog-cancelled();
    // key text (slint::platform::Key for special keys), ctrl/cmd, alt, shift; true when handled
    callback key(string, bool, bool, bool) -> bool;

    // Scrolls the file list so `row` is visible.
    public function ensure-visible(row: int) {
        if (row < 0) {
            return;
        }
        if (row * row-height < -list.content-y) {
            list.content-y = -row * row-height;
        } else if ((row + 1) * row-height > -list.content-y + list.visible-height) {
            list.content-y = -((row + 1) * row-height - list.visible-height);
        }
    }

    // Row the tree should scroll to (3 rows below the top, unless already in view); -1 once done.
    // Re-applied when the list's heights change: right after the rows change it hasn't measured
    // them yet, and the scroll would be clamped.
    in-out property <int> tree-scroll-target: -1;

    public function apply-tree-scroll() {
        if (tree-scroll-target < 0) {
            return;
        }
        if (tree-scroll-target * 24px < -tree-list.content-y || (tree-scroll-target + 1) * 24px > -tree-list.content-y + tree-list.visible-height) {
            tree-list.content-y = -max(0px, (tree-scroll-target - 3) * 24px);
        }
        if (tree-scroll-target * 24px >= -tree-list.content-y && (tree-scroll-target + 1) * 24px <= -tree-list.content-y + tree-list.visible-height) {
            tree-scroll-target = -1;
        }
    }

    public function scroll-to-top() {
        list.content-y = 0;
    }

    // `x`, `y` in window coordinates
    public function show-menu(x: length, y: length) {
        context-menu.show({ x: x, y: y });
    }

    public function focus-list() {
        keys.focus();
    }

    public function focus-address() {
        address-field.focus();
        address-field.select-all();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                // at the focused row, or the list's top left
                let row = root.keyboard-menu();
                root.show-menu(list.absolute-position.x + 40px,
                    list.absolute-position.y + (row < 0 ? 8px : clamp(row * row-height + list.content-y + row-height, 0, list.visible-height)));
                return EventResult.accept;
            }
            if (root.key(event.text, event.modifiers.control || event.modifiers.meta, event.modifiers.alt, event.modifiers.shift)) {
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        VerticalLayout {
            // ---- toolbar ----
            Rectangle {
                height: 42px;
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding: 6px;
                    spacing: 2px;
                    ToolButton {
                        icon: Icons.back;
                        tooltip: "Back (Alt+Left)";
                        enabled: root.can-back;
                        clicked => { root.back(); }
                    }
                    ToolButton {
                        icon: Icons.forward;
                        tooltip: "Forward (Alt+Right)";
                        enabled: root.can-forward;
                        clicked => { root.forward(); }
                    }
                    ToolButton {
                        icon: Icons.up;
                        tooltip: "Up (Alt+Up, Backspace)";
                        enabled: root.can-up;
                        clicked => { root.up(); }
                    }
                    ToolButton {
                        icon: Icons.refresh;
                        tooltip: "Refresh (Ctrl+R)";
                        clicked => { root.refresh(); }
                    }
                    Rectangle { width: 6px; }
                    address-field := LineEdit {
                        text <=> root.address;
                        accessible-label: "Address";
                        accepted(text) => {
                            root.navigate-address(text);
                        }
                    }
                    Rectangle { width: 6px; }
                    ToolButton {
                        icon: Icons.eye;
                        tooltip: "Show hidden files (Ctrl+H)";
                        checked: root.show-hidden;
                        clicked => { root.toggle-hidden(); }
                    }
                }
            }
            Rectangle { height: 1px; background: Palette.border; }

            HorizontalLayout {
                // ---- folder tree ----
                VerticalLayout {
                    width: root.tree-width;
                    tree-list := ListView {
                        changed visible-height => { root.apply-tree-scroll(); }
                        changed viewport-height => { root.apply-tree-scroll(); }
                        for row[i] in root.tree: Rectangle {
                            height: 24px;
                            accessible-role: list-item;
                            accessible-label: row.name;
                            Rectangle {
                                x: 4px;
                                width: parent.width - 8px;
                                border-radius: 4px;
                                background: row.current ? Palette.accent-background.with-alpha(0.18)
                                    : tree-touch.has-hover && !row.header ? Palette.foreground.with-alpha(0.06) : transparent;
                                border-width: row.current ? 1px : 0px;
                                border-color: Palette.accent-background.with-alpha(0.6);
                            }
                            tree-touch := TouchArea {
                                pointer-event(event) => {
                                    // right-click: a menu, never a navigation
                                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                        if (root.tree-menu(i)) {
                                            root.show-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                        }
                                    }
                                }
                                clicked => {
                                    if (!row.header) {
                                        root.tree-clicked(i);
                                    }
                                }
                                double-clicked => {
                                    if (row.expandable) {
                                        root.tree-toggled(i);
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 6px + row.depth * 14px;
                                padding-right: 6px;
                                spacing: 4px;
                                alignment: start;
                                Rectangle {
                                    width: 16px;
                                    if row.expandable: Path {
                                        width: 14px;
                                        height: 14px;
                                        viewbox-width: 24;
                                        viewbox-height: 24;
                                        commands: row.expanded ? Icons.chevron-down : Icons.chevron-right;
                                        fill: Palette.foreground.with-alpha(0.6);
                                    }
                                    TouchArea {
                                        enabled: row.expandable;
                                        clicked => { root.tree-toggled(i); }
                                    }
                                }
                                if !row.header: VerticalLayout {
                                    alignment: center;
                                    FileIcon { kind: row.icon; }
                                }
                                Text {
                                    text: row.name;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    font-weight: row.header || row.on-path ? 600 : 400;
                                    color: row.header ? Palette.foreground.with-alpha(0.6) : Palette.foreground;
                                    font-size: row.header ? 11px : 13px;
                                }
                            }
                        }
                    }
                }

                // ---- splitter ----
                Rectangle {
                    width: 5px;
                    background: splitter.has-hover || splitter.pressed ? Palette.accent-background.with-alpha(0.3) : transparent;
                    Rectangle { x: 2px; width: 1px; background: Palette.border; }
                    splitter := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            root.tree-width = clamp(root.tree-width + self.mouse-x - self.pressed-x, 120px, root.width - 240px);
                        }
                    }
                }

                // ---- details list ----
                VerticalLayout {
                    Rectangle {
                        height: 26px;
                        HorizontalLayout {
                            HeaderCell {
                                title: "Name";
                                sorted: root.sort-column == 0;
                                ascending: root.sort-ascending;
                                clicked => { root.sort-by(0); }
                            }
                            HeaderCell {
                                width: 90px;
                                title: "Size";
                                align: right;
                                sorted: root.sort-column == 1;
                                ascending: root.sort-ascending;
                                clicked => { root.sort-by(1); }
                            }
                            HeaderCell {
                                width: 150px;
                                title: "Type";
                                sorted: root.sort-column == 2;
                                ascending: root.sort-ascending;
                                clicked => { root.sort-by(2); }
                            }
                            HeaderCell {
                                width: 170px;
                                title: "Date modified";
                                sorted: root.sort-column == 3;
                                ascending: root.sort-ascending;
                                clicked => { root.sort-by(3); }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                    }
                    Rectangle {
                        // right-clicks on empty space pass through the list to here: the folder's menu
                        TouchArea {
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    keys.focus();
                                    root.row-menu(-1);
                                    root.show-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        list := ListView {
                            for row[i] in root.files: Rectangle {
                                height: root.row-height;
                                accessible-role: list-item;
                                accessible-label: row.name;
                                accessible-item-selected: row.selected;
                                background: row.selected ? Palette.selection-background.with-alpha(keys.has-focus ? 1.0 : 0.45)
                                    : row-touch.has-hover ? Palette.foreground.with-alpha(0.05) : transparent;
                                border-width: row.current && keys.has-focus ? 1px : 0px;
                                border-color: Palette.accent-background;
                                row-touch := TouchArea {
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                            keys.focus();
                                            root.row-pressed(i, event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                                        }
                                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                            keys.focus();
                                            root.row-menu(i);
                                            root.show-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                        }
                                    }
                                    double-clicked => { root.row-activated(i); }
                                }
                                HorizontalLayout {
                                    property <color> fg: row.selected && keys.has-focus ? Palette.selection-foreground : Palette.foreground;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            FileIcon { kind: row.icon; dimmed: row.hidden; }
                                        }
                                        Text {
                                            text: row.name;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            color: fg;
                                        }
                                    }
                                    // same widths and 6px insets as the header cells, so text lines up and never touches
                                    HorizontalLayout {
                                        width: 90px;
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: row.size;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            color: fg.with-alpha(0.8);
                                        }
                                    }
                                    HorizontalLayout {
                                        width: 150px;
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: row.kind;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            color: fg.with-alpha(0.8);
                                        }
                                    }
                                    HorizontalLayout {
                                        width: 170px;
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: row.modified;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            color: fg.with-alpha(0.8);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.files.length == 0 && root.message != "": Text {
                        text: root.message;
                        horizontal-alignment: center;
                        color: Palette.foreground.with-alpha(0.6);
                        height: 40px;
                    }
                }
            }

            // ---- status line ----
            Rectangle { height: 1px; background: Palette.border; }
            Rectangle {
                height: 24px;
                background: Palette.alternate-background;
                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    text: root.status;
                    vertical-alignment: center;
                    overflow: elide;
                    color: Palette.foreground.with-alpha(0.75);
                    font-size: 12px;
                }
            }
        }
    }

    // The one right-click menu: shown only from code (show-menu), after Rust filled the sections
    // for what was clicked; never by itself (it would show a stale menu).
    context-menu := ContextMenuArea {
        enabled: false;
        Menu {
            for e in root.menu-s0: MenuItem {
                title: e.title;
                enabled: e.enabled;
                checkable: e.checkable;
                checked: e.checked;
                activated => { root.menu-activated(e.id); }
            }
            MenuSeparator { }
            for e in root.menu-s1: MenuItem {
                title: e.title;
                enabled: e.enabled;
                checkable: e.checkable;
                checked: e.checked;
                activated => { root.menu-activated(e.id); }
            }
            if root.menu-sort.length > 0: Menu {
                title: "Sort by";
                for e in root.menu-sort: MenuItem {
                    title: e.title;
                    enabled: e.enabled;
                    checkable: e.checkable;
                    checked: e.checked;
                    activated => { root.menu-activated(e.id); }
                }
            }
            if root.menu-new.length > 0: Menu {
                title: "New";
                for e in root.menu-new: MenuItem {
                    title: e.title;
                    enabled: e.enabled;
                    activated => { root.menu-activated(e.id); }
                }
            }
            MenuSeparator { }
            for e in root.menu-s2: MenuItem {
                title: e.title;
                enabled: e.enabled;
                checkable: e.checkable;
                checked: e.checked;
                activated => { root.menu-activated(e.id); }
            }
            MenuSeparator { }
            for e in root.menu-s3: MenuItem {
                title: e.title;
                enabled: e.enabled;
                checkable: e.checkable;
                checked: e.checked;
                activated => { root.menu-activated(e.id); }
            }
            MenuSeparator { }
            for e in root.menu-s4: MenuItem {
                title: e.title;
                enabled: e.enabled;
                checkable: e.checkable;
                checked: e.checked;
                activated => { root.menu-activated(e.id); }
            }
            MenuSeparator { }
            for e in root.menu-s5: MenuItem {
                title: e.title;
                enabled: e.enabled;
                checkable: e.checkable;
                checked: e.checked;
                activated => { root.menu-activated(e.id); }
            }
        }
    }

    if root.dialog-open: Rectangle {
        background: #00000066;
        // the window behind is not usable while the dialog is open
        TouchArea { }
        FocusScope {
            init => {
                if (!root.dialog-input) {
                    self.focus();
                }
            }
            key-pressed(event) => {
                if (event.text == Key.Escape && root.dialog-can-cancel) {
                    root.dialog-cancelled();
                    return EventResult.accept;
                }
                if (event.text == Key.Return && !root.dialog-input) {
                    root.dialog-accepted(root.dialog-text);
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            card := Rectangle {
                width: min(480px, root.width - 40px);
                height: min(card-layout.preferred-height, root.height - 40px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.background;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                accessible-role: groupbox;
                accessible-label: root.dialog-title;
                card-layout := VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    Text {
                        text: root.dialog-title;
                        font-size: 15px;
                        font-weight: 600;
                    }
                    if root.dialog-message != "": Text {
                        text: root.dialog-message;
                        wrap: word-wrap;
                    }
                    if root.dialog-input: name-field := LineEdit {
                        text <=> root.dialog-text;
                        accessible-label: "Name";
                        init => {
                            self.focus();
                            self.set-selection-offsets(0, root.dialog-select-end);
                        }
                        accepted(text) => { root.dialog-accepted(text); }
                    }
                    if root.dialog-error != "": Text {
                        text: root.dialog-error;
                        wrap: word-wrap;
                        color: #d93a35;
                    }
                    if root.dialog-lines.length > 0: ListView {
                        height: min(root.dialog-lines.length * 20px, 200px);
                        for line in root.dialog-lines: Text {
                            height: 20px;
                            text: line;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        if root.dialog-can-cancel: Button {
                            text: "Cancel";
                            clicked => { root.dialog-cancelled(); }
                        }
                        Button {
                            text: root.dialog-ok;
                            primary: true;
                            clicked => { root.dialog-accepted(root.dialog-text); }
                        }
                    }
                }
            }
        }
    }
}
