// fileEm main window: toolbar, one explorer side or two (Commander style), the right-click menu
// and dialogs. All commands and keys go to Rust (see src/app.rs); the .slint files only lay out
// and draw.

import { Button, LineEdit, ListView, Palette } from "std-widgets.slint";
import { FunctionKey, Icons, ToolButton } from "icons.slint";
import { SidePane, SideView, ColumnRow } from "side.slint";
export { FileRow, TreeRow, TabRow, CrumbRow, ColumnRow, SideView } from "side.slint";
export { ProgressWindow, OpRow } from "progress.slint";
export { PropertiesWindow, PropLine } from "properties.slint";

// One item of a right-click menu (src/menu.rs); `id` is handed back to `menu-activated`.
export struct MenuRow {
    id: int,
    title: string,
    enabled: bool,
    checkable: bool,
    checked: bool,
}

export component AppWindow inherits Window {
    in property <string> window-title: "fileEm";
    title: window-title;
    preferred-width: 1100px;
    preferred-height: 700px;
    min-width: 480px;
    min-height: 320px;
    background: Palette.background;
    default-font-size: 13px;

    in property <SideView> left;
    in property <SideView> right;
    // the second side (F9)
    in property <bool> dual;
    in property <int> active-side;
    // the visible columns after Name, shared by both sides
    in property <[ColumnRow]> columns;
    in property <length> name-width: 300px;
    in property <length> columns-width: 800px;
    in property <bool> show-hidden;
    // Ctrl (Cmd) is held: tracked from key events, for Ctrl+wheel over a list that scrolls
    in-out property <bool> ctrl-held;
    in property <bool> can-back;
    in property <bool> can-forward;
    in property <bool> can-up;
    // the left side's share of the width in dual mode
    in-out property <float> side-split: 0.5;

    callback back();
    callback forward();
    callback up();
    callback refresh();
    callback toggle-hidden();
    callback toggle-dual();
    // ---- from the sides (first argument: 0 left, 1 right) ----
    callback activate(int);
    callback tree-resized(int, length);
    callback row-pressed(int, int, bool, bool);
    callback row-activated(int, int);
    callback row-menu(int, int);
    callback empty-pressed(int);
    callback tree-clicked(int, int);
    callback tree-toggled(int, int);
    callback tree-menu(int, int) -> bool;
    callback sort-by(int, int);
    callback header-menu(int);
    callback column-resized(int, length);
    callback tab-clicked(int, int);
    callback tab-closed(int, int);
    callback tab-new(int);
    callback tab-menu(int, int);
    callback crumb-clicked(int, int);
    callback address-entered(int, string);
    callback filter-edited(int, string);
    callback row-released(int, int);
    callback box-start(int, bool, bool);
    callback box-moved(int, length, length, length, length);
    callback box-ended(int, bool);
    // ---- views (see SidePane) ----
    callback view-menu(int);
    callback sort-menu(int);
    callback size-step(int, int);
    callback size-slider-moved(int, float);
    callback size-slider-released(int);
    callback tab-moved(int, int, int);
    callback column-moved(int, int);
    callback list-measured(int, length);
    callback view-wheel(int, length);
    callback grid-resized(int, length, length);
    callback grid-range(int, int, int);
    // the thumbnail threads decoded something (src/thumbs.rs)
    callback thumbs-ready();
    // ---- drag & drop inside the window (see SidePane) ----
    in property <data-transfer> drag-data;
    in property <image> drag-image;
    callback drag-started(int, int, int, length, length, length, length);
    callback drop-check(int, int, int) -> int;
    callback dropped(int, int, int);
    // the directory watcher saw changes in a tab's folder (token: which watch)
    callback dir-changed(int);

    // ---- right-click menus (built by src/menu.rs on each request) ----
    // sections are separated by lines; the View, Sort by and New submenus follow section 1
    in property <[MenuRow]> menu-s0;
    in property <[MenuRow]> menu-s1;
    in property <[MenuRow]> menu-s2;
    in property <[MenuRow]> menu-s3;
    in property <[MenuRow]> menu-s4;
    in property <[MenuRow]> menu-s5;
    in property <[MenuRow]> menu-view;
    in property <[MenuRow]> menu-sort;
    in property <[MenuRow]> menu-new;
    // the keyboard's menu key: builds the active side's selection menu
    callback keyboard-menu();
    callback menu-activated(int);

    // ---- dialog (drawn over the window; see src/app.rs `Dialog`) ----
    in property <bool> dialog-open;
    in property <string> dialog-title;
    in property <string> dialog-message;
    // a name field (rename, new folder), with the part before the extension selected
    in property <bool> dialog-input;
    in-out property <string> dialog-text;
    in property <int> dialog-select-end;
    in property <string> dialog-error;
    // lines of a list (operation errors)
    in property <[string]> dialog-lines;
    in property <string> dialog-ok: "OK";
    in property <bool> dialog-can-cancel: true;
    // a second choice next to OK (Copy next to Move), empty for none
    in property <string> dialog-alt;
    callback dialog-alternative();
    callback dialog-accepted(string);
    callback dialog-cancelled();
    // key text (slint::platform::Key for special keys), ctrl/cmd, alt, shift; true when handled
    callback key(string, bool, bool, bool) -> bool;


    // `x`, `y` in window coordinates
    public function show-menu(x: length, y: length) {
        context-menu.show({ x: x, y: y });
    }

    public function focus-list() {
        keys.focus();
    }

    // an F-key bar button: does what its key does
    function function-key(key: string) {
        keys.focus();
        root.key(key, false, false, false);
    }

    // A menu takes the keys while it is open; they come back however it closes. Slint tells
    // nothing else about a menu closing.
    property <bool> keys-focus: keys.has-focus;
    changed keys-focus => {
        if (self.keys-focus) {
            root.menu-closed();
        }
    }
    callback menu-closed();
    // a termination signal: save and stop operations (main.rs quits afterwards)
    callback terminate();

    keys := FocusScope {
        // seen before the focused field gets them, wherever the focus is
        capture-key-pressed(event) => {
            if (event.text == Key.Control || event.text == Key.Meta) {
                root.ctrl-held = true;
            }
            return EventResult.reject;
        }
        capture-key-released(event) => {
            if (event.text == Key.Control || event.text == Key.Meta) {
                root.ctrl-held = false;
            }
            return EventResult.reject;
        }
        key-pressed(event) => {
            if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                root.keyboard-menu();
                root.show-menu((root.dual && root.active-side == 1 ? sides.split-x + 5px : 0px)
                    + (root.active-side == 1 ? root.right.tree-width : root.left.tree-width) + 60px, 140px);
                return EventResult.accept;
            }
            if (root.key(event.text, event.modifiers.control || event.modifiers.meta, event.modifiers.alt, event.modifiers.shift)) {
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        VerticalLayout {
            // ---- toolbar ----
            Rectangle {
                height: 42px;
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding: 6px;
                    spacing: 2px;
                    ToolButton {
                        icon: Icons.back;
                        tooltip: "Back (Alt+Left)";
                        enabled: root.can-back;
                        clicked => { root.back(); }
                    }
                    ToolButton {
                        icon: Icons.forward;
                        tooltip: "Forward (Alt+Right)";
                        enabled: root.can-forward;
                        clicked => { root.forward(); }
                    }
                    ToolButton {
                        icon: Icons.up;
                        tooltip: "Up (Alt+Up, Backspace)";
                        enabled: root.can-up;
                        clicked => { root.up(); }
                    }
                    ToolButton {
                        icon: Icons.refresh;
                        tooltip: "Refresh (Ctrl+R)";
                        clicked => { root.refresh(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ToolButton {
                        icon: Icons.split;
                        tooltip: "Second side (F9)";
                        checked: root.dual;
                        clicked => { root.toggle-dual(); }
                    }
                    ToolButton {
                        icon: Icons.eye;
                        tooltip: "Show hidden files (Ctrl+H)";
                        checked: root.show-hidden;
                        clicked => { root.toggle-hidden(); }
                    }
                }
            }
            Rectangle { height: 1px; background: Palette.border; }

            // ---- the sides ----
            // placed by hand, not by a layout: their widths follow the divider
            sides := Rectangle {
                property <length> split-x: (self.width - 5px) * root.side-split;
                // both always exist (the right one hidden without the second side): showing it
                // must not rebuild the left one, which would lose its scroll positions
                for s in 2: SidePane {
                    side: s;
                    visible: s == 0 || root.dual;
                    x: s == 0 ? 0px : root.dual ? sides.split-x + 5px : sides.width;
                    y: 0px;
                    width: !root.dual ? (s == 0 ? sides.width : 0px) : s == 0 ? sides.split-x : sides.width - sides.split-x - 5px;
                    height: s == 0 || root.dual ? sides.height : 0px;
                    view: s == 0 ? root.left : root.right;
                    columns: root.columns;
                    name-width: root.name-width;
                    columns-width: root.columns-width;
                    keys-focused: keys.has-focus;
                    ctrl-held <=> root.ctrl-held;
                    dual: root.dual;
                    drag-data: root.drag-data;
                    drag-image: root.drag-image;
                    activate(i) => { root.activate(i); }
                    row-released(i, r) => { root.row-released(i, r); }
                    box-start(i, c, sh) => { root.box-start(i, c, sh); }
                    box-moved(i, ax, ay, mx, my) => { root.box-moved(i, ax, ay, mx, my); }
                    view-menu(i) => { root.view-menu(i); }
                    sort-menu(i) => { root.sort-menu(i); }
                    size-step(i, d) => { root.size-step(i, d); }
                    size-slider-moved(i, v) => { root.size-slider-moved(i, v); }
                    size-slider-released(i) => { root.size-slider-released(i); }
                    tab-moved(i, from, gap) => { root.tab-moved(i, from, gap); }
                    column-moved(c, gap) => { root.column-moved(c, gap); }
                    list-measured(i, w) => { root.list-measured(i, w); }
                    view-wheel(i, d) => { root.view-wheel(i, d); }
                    grid-resized(i, w, h) => { root.grid-resized(i, w, h); }
                    grid-range(i, first, count) => { root.grid-range(i, first, count); }
                    box-ended(i, drawn) => { root.box-ended(i, drawn); }
                    drag-started(i, kind, r, x, y, w, h) => { root.drag-started(i, kind, r, x, y, w, h); }
                    drop-check(i, kind, r) => { return root.drop-check(i, kind, r); }
                    dropped(i, kind, r) => { root.dropped(i, kind, r); }
                    focus-keys => { keys.focus(); }
                    show-menu(x, y) => { root.show-menu(x, y); }
                    tree-resized(i, w) => { root.tree-resized(i, w); }
                    row-pressed(i, r, c, sh) => { root.row-pressed(i, r, c, sh); }
                    row-activated(i, r) => { root.row-activated(i, r); }
                    row-menu(i, r) => { root.row-menu(i, r); }
                    empty-pressed(i) => { root.empty-pressed(i); }
                    tree-clicked(i, r) => { root.tree-clicked(i, r); }
                    tree-toggled(i, r) => { root.tree-toggled(i, r); }
                    tree-menu(i, r) => { return root.tree-menu(i, r); }
                    sort-by(i, c) => { root.sort-by(i, c); }
                    header-menu(i) => { root.header-menu(i); }
                    column-resized(c, w) => { root.column-resized(c, w); }
                    tab-clicked(i, t) => { root.tab-clicked(i, t); }
                    tab-closed(i, t) => { root.tab-closed(i, t); }
                    tab-new(i) => { root.tab-new(i); }
                    tab-menu(i, t) => { root.tab-menu(i, t); }
                    crumb-clicked(i, c) => { root.crumb-clicked(i, c); }
                    address-entered(i, text) => { root.address-entered(i, text); }
                    filter-edited(i, text) => { root.filter-edited(i, text); }
                }
                // the divider between the sides
                if root.dual: Rectangle {
                    x: sides.split-x;
                    width: 5px;
                    background: side-splitter.has-hover || side-splitter.pressed ? Palette.accent-background.with-alpha(0.3) : Palette.alternate-background;
                    Rectangle { x: 2px; width: 1px; background: Palette.border; }
                    side-splitter := TouchArea {
                        mouse-cursor: col-resize;
                        moved => {
                            root.side-split = clamp((sides.split-x + self.mouse-x - self.pressed-x) / (sides.width - 5px), 0.2, 0.8);
                        }
                    }
                }
            }

            // ---- the F-key bar: each button presses its key ----
            Rectangle { height: 1px; background: Palette.border; }
            Rectangle {
                background: Palette.alternate-background;
                HorizontalLayout {
                    padding: 3px;
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    FunctionKey { key: "F2"; label: "Rename"; clicked => { root.function-key(Key.F2); } }
                    // copy and move go to the other side, so they need it shown
                    FunctionKey { key: "F5"; label: "Copy"; enabled: root.dual; clicked => { root.function-key(Key.F5); } }
                    FunctionKey { key: "F6"; label: "Move"; enabled: root.dual; clicked => { root.function-key(Key.F6); } }
                    FunctionKey { key: "F7"; label: "New folder"; clicked => { root.function-key(Key.F7); } }
                    FunctionKey { key: "F8"; label: "Delete"; clicked => { root.function-key(Key.F8); } }
                    FunctionKey { key: "F9"; label: "Dual pane"; clicked => { root.function-key(Key.F9); } }
                    FunctionKey { key: "Tab"; label: "Switch side"; clicked => { root.function-key(Key.Tab); } }
                }
            }
        }
    }

    // The one right-click menu: shown only from code (show-menu), after Rust filled the sections
    // for what was clicked; never by itself (it would show a stale menu).
    context-menu := ContextMenuArea {
        enabled: false;
        Menu {
            for e in root.menu-s0: MenuItem {
                title: e.title;
                enabled: e.enabled;
                checkable: e.checkable;
                checked: e.checked;
                activated => { root.menu-activated(e.id); }
            }
            MenuSeparator { }
            for e in root.menu-s1: MenuItem {
                title: e.title;
                enabled: e.enabled;
                checkable: e.checkable;
                checked: e.checked;
                activated => { root.menu-activated(e.id); }
            }
            if root.menu-view.length > 0: Menu {
                title: "View";
                for e in root.menu-view: MenuItem {
                    title: e.title;
                    enabled: e.enabled;
                    checkable: e.checkable;
                    checked: e.checked;
                    activated => { root.menu-activated(e.id); }
                }
            }
            if root.menu-sort.length > 0: Menu {
                title: "Sort by";
                for e in root.menu-sort: MenuItem {
                    title: e.title;
                    enabled: e.enabled;
                    checkable: e.checkable;
                    checked: e.checked;
                    activated => { root.menu-activated(e.id); }
                }
            }
            if root.menu-new.length > 0: Menu {
                title: "New";
                for e in root.menu-new: MenuItem {
                    title: e.title;
                    enabled: e.enabled;
                    activated => { root.menu-activated(e.id); }
                }
            }
            MenuSeparator { }
            for e in root.menu-s2: MenuItem {
                title: e.title;
                enabled: e.enabled;
                checkable: e.checkable;
                checked: e.checked;
                activated => { root.menu-activated(e.id); }
            }
            MenuSeparator { }
            for e in root.menu-s3: MenuItem {
                title: e.title;
                enabled: e.enabled;
                checkable: e.checkable;
                checked: e.checked;
                activated => { root.menu-activated(e.id); }
            }
            MenuSeparator { }
            for e in root.menu-s4: MenuItem {
                title: e.title;
                enabled: e.enabled;
                checkable: e.checkable;
                checked: e.checked;
                activated => { root.menu-activated(e.id); }
            }
            MenuSeparator { }
            for e in root.menu-s5: MenuItem {
                title: e.title;
                enabled: e.enabled;
                checkable: e.checkable;
                checked: e.checked;
                activated => { root.menu-activated(e.id); }
            }
        }
    }

    if root.dialog-open: Rectangle {
        background: #00000066;
        // the window behind is not usable while the dialog is open
        TouchArea { }
        FocusScope {
            init => {
                if (!root.dialog-input) {
                    self.focus();
                }
            }
            key-pressed(event) => {
                if (event.text == Key.Escape && root.dialog-can-cancel) {
                    root.dialog-cancelled();
                    return EventResult.accept;
                }
                if (event.text == Key.Return && !root.dialog-input) {
                    root.dialog-accepted(root.dialog-text);
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            card := Rectangle {
                width: min(480px, root.width - 40px);
                height: min(card-layout.preferred-height, root.height - 40px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.background;
                border-radius: 8px;
                border-width: 1px;
                border-color: Palette.border;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000055;
                accessible-role: groupbox;
                accessible-label: root.dialog-title;
                card-layout := VerticalLayout {
                    padding: 18px;
                    spacing: 10px;
                    Text {
                        text: root.dialog-title;
                        font-size: 15px;
                        font-weight: 600;
                    }
                    if root.dialog-message != "": Text {
                        text: root.dialog-message;
                        wrap: word-wrap;
                    }
                    if root.dialog-input: name-field := LineEdit {
                        text <=> root.dialog-text;
                        accessible-label: "Name";
                        init => {
                            self.focus();
                            self.set-selection-offsets(0, root.dialog-select-end);
                        }
                        accepted(text) => { root.dialog-accepted(text); }
                    }
                    if root.dialog-error != "": Text {
                        text: root.dialog-error;
                        wrap: word-wrap;
                        color: #d93a35;
                    }
                    if root.dialog-lines.length > 0: ListView {
                        height: min(root.dialog-lines.length * 20px, 200px);
                        for line in root.dialog-lines: Text {
                            height: 20px;
                            text: line;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        if root.dialog-can-cancel: Button {
                            text: "Cancel";
                            clicked => { root.dialog-cancelled(); }
                        }
                        if root.dialog-alt != "": Button {
                            text: root.dialog-alt;
                            clicked => { root.dialog-alternative(); }
                        }
                        Button {
                            text: root.dialog-ok;
                            primary: true;
                            clicked => { root.dialog-accepted(root.dialog-text); }
                        }
                    }
                }
            }
        }
    }
}
